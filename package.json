{
  "name": "otto-goethe-b1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:payments": "node --test tests/payment-backend.test.mjs",
    "test:auth": "node --test tests/auth-backend.test.mjs && npm run test:profile-email",
    "test:profile-email": "node --experimental-vm-modules --test tests/profile-email.test.mjs",
    "test:learning": "node --test tests/learning-experience.test.mjs tests/hoeren-parts.test.mjs tests/schreiben-drafts.test.mjs tests/task-results-bridge.test.mjs",
    "test:preview-learning": "node --test tests/preview-learning-static.test.mjs",
    "test:seo": "node --test tests/seo-static.test.mjs tests/indexnow.test.mjs",
    "test:b1": "node --test tests/b1-content.test.mjs",
    "check:b1": "npm run typecheck && npm run test:b1 && npm run build"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.0.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pdfkit": "^0.15.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
